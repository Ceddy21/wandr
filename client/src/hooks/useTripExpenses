import { useState } from 'react';
import toast from 'react-hot-toast';

const API_BASE_URL = import.meta.env.VITE_API_URL || 'http://localhost:5000';

export const useTripExpenses = (tripId, trip, setTrip) => {
  const [newExpense, setNewExpense] = useState({
    description: '',
    amount: '',
    paidBy: '',
    date: '',
  });

  const addExpense = async () => {
    if (!newExpense.description || !newExpense.amount || !newExpense.paidBy) {
      toast.error('Please fill in all fields');
      return;
    }

    try {
      const res = await fetch(`${API_BASE_URL}/api/trips/${tripId}/expenses`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          description: newExpense.description,
          amount: parseFloat(newExpense.amount),
          paidBy: newExpense.paidBy,
          date: newExpense.date || new Date().toISOString().split('T')[0],
        }),
        credentials: 'include',
      });

      if (!res.ok) throw new Error('Failed to add expense');

      const updatedTrip = await res.json();
      setTrip(updatedTrip);

      const adminName = trip.members.find(m => m.role === 'admin')?.name || trip.members[0]?.name || '';
      setNewExpense({
        description: '',
        amount: '',
        paidBy: adminName,
        date: new Date().toISOString().split('T')[0],
      });

      toast.success('Expense added!');
    } catch (err) {
      toast.error(err.message || 'Failed to add expense');
    }
  };

  return { newExpense, setNewExpense, addExpense };
};